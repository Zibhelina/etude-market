  "content": {
    "manifest": {
      "etude": "plugin/1",
      "id": "pomodoro",
      "name": "Pomodoro",
      "version": "1.0.0",
      "author": "Etude",
      "description": "A focus timer that floats over every screen, folds into a pill, chimes when a phase ends, and adds Ctrl/⌘K commands.",
      "main": "main.js",
      "views": {
        "timer": "timer.html"
      },
      "permissions": [
        "ui.commands",
        "ui.floating",
        "notify",
        "storage"
      ],
      "platforms": [
        "desktop",
        "web"
      ]
    },
    "files": {
      "main.js": "// Pomodoro plugin controller: registers Ctrl/⌘K & right-click commands and coordinates timer state\n// in plugin storage so it survives reloads and stays consistent across screens.\nconst MIN = 60_000;\nconst DEFAULT = {\n  phase: \"focus\",\n  running: false,\n  endsAt: null,\n  left: 25 * MIN,\n  done: 0,\n  mins: { focus: 25, short: 5, long: 15 },\n  every: 4,\n  auto: false,\n  folded: false,\n};\n\nconst total = (s, p = s.phase) => (s.mins?.[p] ?? 25) * MIN;\nconst remaining = (s, now) => (s.running && s.endsAt != null ? Math.max(0, s.endsAt - now) : s.left);\n\nasync function readState() {\n  const saved = await etude.storage.get(\"state\");\n  if (!saved || typeof saved !== \"object\") return { ...DEFAULT, mins: { ...DEFAULT.mins } };\n  return { ...DEFAULT, ...saved, mins: { ...DEFAULT.mins, ...(saved.mins ?? {}) } };\n}\n\nasync function writeState(next) {\n  await etude.storage.set(\"state\", next);\n  etude.floating.post({ type: \"state\", state: next });\n  return next;\n}\n\nasync function toggleTimer() {\n  const s = await readState();\n  const now = Date.now();\n  const next = s.running\n    ? { ...s, running: false, endsAt: null, left: remaining(s, now) }\n    : { ...s, running: true, endsAt: now + (s.left > 0 ? s.left : total(s)) };\n  await writeState(next);\n  if (!(await etude.floating.isOpen())) {\n    await etude.floating.open({ view: \"timer\", title: \"Pomodoro\", width: 272, height: 326 });\n  }\n}\n\nasync function resetTimer() {\n  const s = await readState();\n  await writeState({ ...s, running: false, endsAt: null, left: total(s) });\n}\n\netude.commands.register({\n  id: \"toggle-view\",\n  label: \"Pomodoro: Show / hide timer\",\n  shortcut: \"Mod+Alt+P\",\n  contextMenu: true,\n  async run() {\n    if (await etude.floating.isOpen()) await etude.floating.close();\n    else {\n      const s = await readState();\n      await etude.floating.open({ view: \"timer\", title: \"Pomodoro\", width: s.folded ? 156 : 272, height: s.folded ? 46 : 326 });\n    }\n  },\n});\n\netude.commands.register({\n  id: \"start-pause\",\n  label: \"Pomodoro: Start / pause\",\n  async run() {\n    await toggleTimer();\n  },\n});\n\netude.commands.register({\n  id: \"reset\",\n  label: \"Pomodoro: Reset current phase\",\n  async run() {\n    await resetTimer();\n  },\n});\n\netude.onAction(async (actionId) => {\n  if (actionId === \"start-next\") await toggleTimer();\n});\n\n// Keep timer running across reloads if a phase is active.\nconst initial = await readState();\nif (initial.running) {\n  await etude.floating.open({ view: \"timer\", title: \"Pomodoro\", width: initial.folded ? 156 : 272, height: initial.folded ? 46 : 326 });\n}\n",
      "timer.html": "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<style>\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; background: var(--card, transparent); color: var(--foreground, #e7e5e4); font-family: var(--font-sans, Inter, system-ui, sans-serif); user-select: none; overflow: hidden; }\n  .card { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 10px; }\n  .tabs { display: flex; gap: 2px; background: var(--background, #111); padding: 2px; border-radius: 999px; border: 1px solid var(--border, #2a2a2a); }\n  .tab { flex: 1; height: 24px; border: 0; border-radius: 999px; background: transparent; color: var(--foreground, #e7e5e4); font-size: 12px; font-weight: 500; cursor: pointer; }\n  .tab.active { background: var(--phase-color); color: var(--phase-fg); font-weight: 600; }\n  .ring-wrap { display: flex; justify-content: center; padding: 4px 0 0; }\n  .ring { position: relative; width: 152px; height: 152px; display: grid; place-items: center; }\n  .ring svg { position: absolute; inset: 0; transform: rotate(-90deg); }\n  .clock { font-size: 40px; line-height: 1; font-weight: 650; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }\n  .phase-lbl { font-size: 12.5px; font-weight: 600; color: var(--phase-color); margin-top: 6px; text-align: center; }\n  .dots { display: flex; justify-content: center; gap: 6px; }\n  .dot { width: 8px; height: 8px; border-radius: 999px; background: color-mix(in oklab, var(--foreground, #fff) 16%, transparent); }\n  .dot.on { background: var(--primary, #22c55e); }\n  .controls { display: flex; align-items: center; gap: 8px; }\n  .icon-btn { width: 36px; height: 36px; border: 0; border-radius: 999px; background: transparent; color: var(--foreground, #e7e5e4); cursor: pointer; display: grid; place-items: center; font-size: 15px; }\n  .icon-btn:hover { background: var(--accent, rgba(255,255,255,0.08)); }\n  .main-btn { flex: 1; height: 38px; border: 0; border-radius: 999px; background: var(--phase-color); color: var(--phase-fg); font-size: 14px; font-weight: 600; cursor: pointer; }\n  .main-btn:hover { filter: brightness(1.08); }\n  .row-foot { display: flex; justify-content: space-between; align-items: center; gap: 6px; }\n  .link-btn { border: 0; background: transparent; color: var(--foreground, #e7e5e4); font-size: 12px; font-weight: 500; cursor: pointer; padding: 4px 6px; border-radius: 6px; }\n  .link-btn:hover { background: var(--accent, rgba(255,255,255,0.08)); }\n  .setup { display: flex; flex-direction: column; gap: 8px; border-top: 1px solid var(--border, #2a2a2a); padding-top: 10px; font-size: 12.5px; }\n  .setup label { display: flex; justify-content: space-between; align-items: center; gap: 8px; }\n  .setup input[type=\"number\"] { width: 56px; height: 26px; border-radius: 6px; border: 1px solid var(--border, #2a2a2a); background: var(--background, #111); color: var(--foreground, #fff); text-align: right; padding: 0 6px; font-variant-numeric: tabular-nums; }\n  .pill { display: flex; align-items: center; gap: 8px; height: 42px; padding: 4px 6px 4px 10px; cursor: pointer; }\n  .pill-clock { font-size: 15px; font-weight: 650; font-variant-numeric: tabular-nums; flex: 1; }\n  .pill-btn { width: 30px; height: 30px; border: 0; border-radius: 999px; background: var(--phase-color); color: var(--phase-fg); font-size: 12px; font-weight: 700; cursor: pointer; display: grid; place-items: center; }\n</style>\n</head>\n<body>\n<div id=\"root\"></div>\n<script>\nconst MIN = 60_000;\nconst PHASES = [\"focus\", \"short\", \"long\"];\nconst SHORT = { focus: \"Focus\", short: \"Short\", long: \"Long\" };\nconst FULL = { focus: \"Focus\", short: \"Short break\", long: \"Long break\" };\nconst COLOR = { focus: \"var(--primary, #22c55e)\", short: \"#4aa3df\", long: \"#9a7cf0\" };\nconst FG = { focus: \"var(--primary-foreground, #000)\", short: \"#fff\", long: \"#fff\" };\nconst DEFAULT = { phase: \"focus\", running: false, endsAt: null, left: 25 * MIN, done: 0, mins: { focus: 25, short: 5, long: 15 }, every: 4, auto: false, folded: false };\n\nlet state = { ...DEFAULT, mins: { ...DEFAULT.mins } };\nlet setup = false;\nlet lastNotifiedEnd = 0;\n\nconst total = (s, p = s.phase) => (s.mins[p] || 25) * MIN;\nconst remaining = (s, now) => (s.running && s.endsAt != null ? Math.max(0, s.endsAt - now) : s.left);\nconst fmt = (ms) => {\n  const t = Math.ceil(ms / 1000);\n  return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, \"0\")}`;\n};\n\nasync function save(next) {\n  state = next;\n  await etude.storage.set(\"state\", state);\n  resize();\n  render();\n}\n\nfunction nextPhase(s, counted) {\n  if (s.phase !== \"focus\") return { phase: \"focus\", done: s.done };\n  const done = s.done + (counted ? 1 : 0);\n  return { phase: counted && done % s.every === 0 ? \"long\" : \"short\", done };\n}\n\nfunction advance(s, now, counted) {\n  const { phase, done } = nextPhase(s, counted);\n  const next = { ...s, phase, done, running: false, endsAt: null, left: total(s, phase) };\n  const from = counted && s.endsAt != null ? Math.min(now, s.endsAt) : now;\n  return s.auto && counted ? { ...next, running: true, endsAt: from + total(next) } : next;\n}\n\nfunction resize() {\n  if (state.folded) etude.floating.resize({ width: 156, height: 46 });\n  else etude.floating.resize({ width: 272, height: setup ? 470 : 326 });\n}\n\nfunction render() {\n  const now = Date.now();\n  const left = remaining(state, now);\n  const frac = Math.min(1, Math.max(0, 1 - left / total(state)));\n  document.documentElement.style.setProperty(\"--phase-color\", COLOR[state.phase]);\n  document.documentElement.style.setProperty(\"--phase-fg\", FG[state.phase]);\n  const root = document.getElementById(\"root\");\n\n  if (state.folded) {\n    const r = 9, c = 2 * Math.PI * r;\n    root.innerHTML = `\n      <div class=\"pill\" id=\"unfold\" title=\"Click to expand\">\n        <svg width=\"22\" height=\"22\" style=\"transform:rotate(-90deg)\">\n          <circle cx=\"11\" cy=\"11\" r=\"${r}\" fill=\"none\" stroke=\"color-mix(in oklab, var(--foreground, #fff) 16%, transparent)\" stroke-width=\"3\"></circle>\n          <circle cx=\"11\" cy=\"11\" r=\"${r}\" fill=\"none\" stroke=\"${COLOR[state.phase]}\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-dasharray=\"${c}\" stroke-dashoffset=\"${c * (1 - frac)}\"></circle>\n        </svg>\n        <span class=\"pill-clock\">${fmt(left)}</span>\n        <button class=\"pill-btn\" id=\"pill-toggle\" aria-label=\"${state.running ? \"Pause\" : \"Start\"}\">${state.running ? \"❚❚\" : \"▶\"}</button>\n      </div>\n    `;\n    document.getElementById(\"unfold\").onclick = (e) => {\n      if (e.target.closest(\"button\")) return;\n      save({ ...state, folded: false });\n    };\n    document.getElementById(\"pill-toggle\").onclick = (e) => {\n      e.stopPropagation();\n      toggle();\n    };\n    return;\n  }\n\n  const r = 72, c = 2 * Math.PI * r;\n  const inCycle = state.phase === \"long\" && state.done > 0 && state.done % state.every === 0 ? state.every : state.done % state.every;\n  const dots = Array.from({ length: state.every }, (_, i) => `<span class=\"dot ${i < inCycle ? \"on\" : \"\"}\"></span>`).join(\"\");\n\n  root.innerHTML = `\n    <div class=\"card\">\n      <div class=\"tabs\">\n        ${PHASES.map((p) => `<button class=\"tab ${state.phase === p ? \"active\" : \"\"}\" data-phase=\"${p}\">${SHORT[p]}</button>`).join(\"\")}\n      </div>\n      <div class=\"ring-wrap\">\n        <div class=\"ring\">\n          <svg width=\"152\" height=\"152\">\n            <circle cx=\"76\" cy=\"76\" r=\"${r}\" fill=\"none\" stroke=\"color-mix(in oklab, var(--foreground, #fff) 12%, transparent)\" stroke-width=\"7\"></circle>\n            <circle cx=\"76\" cy=\"76\" r=\"${r}\" fill=\"none\" stroke=\"${COLOR[state.phase]}\" stroke-width=\"7\" stroke-linecap=\"round\" stroke-dasharray=\"${c}\" stroke-dashoffset=\"${c * (1 - frac)}\"></circle>\n          </svg>\n          <div>\n            <div class=\"clock\" role=\"timer\">${fmt(left)}</div>\n            <div class=\"phase-lbl\">${FULL[state.phase]}</div>\n          </div>\n        </div>\n      </div>\n      <div class=\"dots\" title=\"${state.done} focus sessions done\">${dots}</div>\n      <div class=\"controls\">\n        <button class=\"icon-btn\" id=\"reset\" title=\"Reset phase\" aria-label=\"Reset\">↺</button>\n        <button class=\"main-btn\" id=\"toggle\">${state.running ? \"Pause\" : left < total(state) ? \"Resume\" : \"Start\"}</button>\n        <button class=\"icon-btn\" id=\"skip\" title=\"Skip phase\" aria-label=\"Skip\">⏭</button>\n      </div>\n      <div class=\"row-foot\">\n        <button class=\"link-btn\" id=\"fold\">Fold to pill</button>\n        <button class=\"link-btn\" id=\"times\">${setup ? \"Done\" : \"Times\"}</button>\n      </div>\n      ${setup ? `\n        <div class=\"setup\">\n          ${PHASES.map((p) => `<label>${FULL[p]}<span><input type=\"number\" min=\"1\" max=\"180\" data-min=\"${p}\" value=\"${state.mins[p]}\"> min</span></label>`).join(\"\")}\n          <label>Long break after<span><input type=\"number\" min=\"2\" max=\"12\" id=\"every\" value=\"${state.every}\"> ×</span></label>\n          <label>Auto-start next<input type=\"checkbox\" id=\"auto\" ${state.auto ? \"checked\" : \"\"}></label>\n        </div>\n      ` : \"\"}\n    </div>\n  `;\n\n  root.querySelectorAll(\"[data-phase]\").forEach((btn) => {\n    btn.onclick = () => {\n      const p = btn.dataset.phase;\n      save({ ...state, phase: p, running: false, endsAt: null, left: total(state, p) });\n    };\n  });\n  document.getElementById(\"reset\").onclick = () => save({ ...state, running: false, endsAt: null, left: total(state) });\n  document.getElementById(\"toggle\").onclick = toggle;\n  document.getElementById(\"skip\").onclick = () => save(advance(state, Date.now(), false));\n  document.getElementById(\"fold\").onclick = () => save({ ...state, folded: true });\n  document.getElementById(\"times\").onclick = () => {\n    setup = !setup;\n    resize();\n    render();\n  };\n  if (setup) {\n    root.querySelectorAll(\"[data-min]\").forEach((inp) => {\n      inp.onchange = () => {\n        const p = inp.dataset.min;\n        const m = Math.min(180, Math.max(1, Math.round(Number(inp.value)) || 1));\n        const mins = { ...state.mins, [p]: m };\n        const next = { ...state, mins };\n        if (p === state.phase && !state.running && state.left === total(state)) next.left = m * MIN;\n        save(next);\n      };\n    });\n    document.getElementById(\"every\").onchange = (e) => save({ ...state, every: Math.min(12, Math.max(2, Math.round(Number(e.target.value)) || 4)) });\n    document.getElementById(\"auto\").onchange = (e) => save({ ...state, auto: !!e.target.checked });\n  }\n}\n\nfunction toggle() {\n  const now = Date.now();\n  if (state.running) save({ ...state, running: false, endsAt: null, left: remaining(state, now) });\n  else save({ ...state, running: true, endsAt: now + (state.left > 0 ? state.left : total(state)) });\n}\n\nasync function tick() {\n  if (!state.running || state.endsAt == null) return;\n  const now = Date.now();\n  if (now >= state.endsAt && lastNotifiedEnd !== state.endsAt) {\n    lastNotifiedEnd = state.endsAt;\n    const before = state;\n    const after = advance(before, now, true);\n    await save(after);\n    await etude.storage.appendEvent(\"phase.done\", { phase: before.phase, mins: before.mins[before.phase], done: after.done });\n    const title = before.phase === \"focus\" ? (after.phase === \"long\" ? `Focus done: ${after.done} in a row. Long break` : \"Focus done. Take a break\") : \"Break's over\";\n    const description = after.running ? `${FULL[after.phase]} started: ${after.mins[after.phase]} min` : `${FULL[after.phase]} next: ${after.mins[after.phase]} min`;\n    etude.notify({\n      title,\n      description,\n      chime: true,\n      actionLabel: after.running ? undefined : (after.phase === \"focus\" ? \"Start focus\" : \"Start break\"),\n      actionId: after.running ? undefined : \"start-next\",\n    });\n    return;\n  }\n  render();\n}\n\netude.onMessage((msg) => {\n  if (msg?.type === \"state\" && msg.state) {\n    state = { ...DEFAULT, ...msg.state, mins: { ...DEFAULT.mins, ...(msg.state.mins ?? {}) } };\n    resize();\n    render();\n  }\n});\n\n(async () => {\n  const saved = await etude.storage.get(\"state\");\n  if (saved && typeof saved === \"object\") state = { ...DEFAULT, ...saved, mins: { ...DEFAULT.mins, ...(saved.mins ?? {}) } };\n  resize();\n  render();\n  setInterval(tick, 250);\n})();\n</script>\n</body>\n</html>\n"
    },
    "hash": "71b2d2ab4450385a45d9045e3101ae4e078dc2ca4b9ed118340cd4101277cf63"
  }
}
