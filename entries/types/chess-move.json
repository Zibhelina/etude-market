        "prepare": "const [placement, turn] = String(fields.fen ?? \"\").trim().split(/\\s+/);\nconst board = {};\nplacement.split(\"/\").forEach((row, r) => {\n  let f = 0;\n  for (const ch of row) {\n    if (/\\d/.test(ch)) f += Number(ch);\n    else { board[\"abcdefgh\"[f] + (8 - r)] = ch; f++; }\n  }\n});\nconst side = turn === \"b\" ? \"b\" : \"w\";\nconst theirKing = Object.keys(board).find((sq) => board[sq] === (side === \"w\" ? \"k\" : \"K\"));\nreturn {\n  view: { prompt: fields.prompt ?? \"\", board, side },\n  key: { answers: (fields.answers ?? []).map((m) => String(m).toLowerCase()), san: fields.san ?? \"\", king: theirKing, explanation: fields.explanation ?? \"\" },\n};\n",
        "template": {
          "html": "<div class=\"sc-eyebrow\">Chess</div>\n<div class=\"prose ch-prompt\">{{md:prompt}}</div>\n<div class=\"ch-turn\"></div>\n<div class=\"ch-board\"></div>\n<p class=\"e-muted ch-help only-answer\">Tap a piece, then the square to move it to. Or drag it.</p>\n<template data-on=\"result\">\n  <div class=\"e-reveal\">\n    <div class=\"ch-answer\"></div>\n    {{#explanation}}<div class=\"prose\">{{md:explanation}}</div>{{/explanation}}\n    <p class=\"sc-how\">You played the move on a real board, and it was checked against every mate in one in this position, as found by a chess engine.</p>\n  </div>\n</template>\n",
          "css": ".sc-eyebrow { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--highlight); margin-bottom: -0.5rem; }\n.sc-how { font-size: 0.85rem; color: var(--muted-foreground); border-top: 1px solid var(--border); padding-top: 0.75rem; margin: 0.25rem 0 0; }\n\n.ch-prompt { font-size: 1.05rem; }\n.ch-turn { display: flex; align-items: center; gap: 0.5rem; font-size: 0.92rem; color: var(--muted-foreground); margin-top: -0.6rem; }\n.ch-turn .dot { width: 0.85rem; height: 0.85rem; border-radius: 50%; border: 1.5px solid var(--foreground); }\n.ch-turn .dot.w { background: #f4f1ea; }\n.ch-turn .dot.b { background: #1d1b19; }\n.ch-board svg { width: 100%; max-width: 28rem; height: auto; display: block; margin: 0 auto; border-radius: calc(var(--radius) - 2px); touch-action: none; user-select: none; -webkit-user-select: none; cursor: pointer; }\n/* The board keeps its own colors in every theme, like a real board. */\n.sq.lt { fill: #dcd6cc; }\n.sq.dk { fill: #8f8579; }\n.co { font: 700 19px var(--font-sans); pointer-events: none; }\n.co.on-lt { fill: #776d62; }\n.co.on-dk { fill: #ece7df; }\n.pc .fill { fill: #1d1b19; }\n.pc.w .fill { fill: #f7f4ee; }\n.pc.w .line { fill: #1d1b19; }\n.pc { pointer-events: none; }\n.pc.lifted { opacity: 0.35; }\n.ghost { opacity: 0.9; }\n.marks .sel { fill: color-mix(in oklab, var(--highlight) 55%, transparent); }\n.marks .last { fill: rgba(231, 196, 76, 0.45); }\n.marks .last.ok { fill: color-mix(in oklab, var(--success) 50%, transparent); }\n.marks .mated { fill: none; stroke: var(--danger); stroke-width: 6; animation: ring 0.4s ease-out; }\n@keyframes ring { from { r: 20; opacity: 0; } }\n.arrow.bad { stroke: var(--danger); stroke-width: 11; stroke-linecap: round; opacity: 0.85; }\n.ahb { fill: var(--danger); }\n.ch-help { font-size: 0.82rem; margin: -0.5rem 0 0; text-align: center; }\n.ch-answer p { margin: 0; font-size: 1.05rem; }\n",
          "js": "// Chess pieces traced from Noto Sans Symbols 2 (OFL): s = solid silhouette, o = outline with the inner detail. 1000 units per em.\nconst PIECE = {\"sK\": \"M500 -34Q454 -34 417 -30Q380 -25 353 -18Q299 -3 299 24L313 227Q203 343 203 436Q203 499 236 536Q268 573 325 573Q391 573 439 525L435 591Q432 628 483 636V692H442V716H483V753H517V716H558V692H517V636Q568 628 565 591L561 525Q609 573 675 573Q732 573 764 536Q797 499 797 436Q797 343 687 227L701 24Q701 -3 647 -18Q620 -25 584 -30Q547 -34 500 -34ZM500 422Q515 462 528 483V578Q528 611 500 611Q472 611 472 578V483Q485 462 500 422ZM500 448Q498 457 494 469Q491 481 487 491V562Q487 570 489 578Q491 585 500 585Q509 585 511 578Q513 570 513 562V491Q509 481 506 469Q502 457 500 448ZM347 247Q422 262 479 262V294Q479 338 468 380Q456 422 435 456Q414 490 386 510Q359 531 327 531Q290 531 269 504Q248 478 248 431Q248 393 276 342Q304 291 347 247ZM653 247Q696 291 724 342Q752 393 752 431Q752 478 732 504Q711 531 673 531Q641 531 614 510Q586 490 565 456Q544 422 532 380Q521 338 521 294V262Q578 262 653 247ZM351 279Q279 363 279 422Q279 457 294 478Q308 499 337 499Q370 499 396 468Q423 438 438 392Q454 345 454 295V290Q436 290 410 287Q385 284 351 279ZM649 279Q615 284 590 287Q564 290 546 290V295Q546 345 562 392Q577 438 604 468Q631 499 663 499Q692 499 706 478Q721 457 721 422Q721 363 649 279ZM353 149Q363 153 386 157Q410 161 440 164Q471 166 500 166Q530 166 560 164Q590 161 614 157Q637 153 647 149L645 177Q613 185 577 190Q541 194 500 194Q460 194 424 190Q387 185 355 177ZM346 72Q399 90 500 90Q602 90 654 72L652 98Q624 106 582 112Q540 118 500 118Q460 118 418 112Q376 106 348 98Z\", \"oK\": \"M500 -34Q454 -34 417 -30Q380 -25 353 -18Q299 -3 299 24L313 227Q203 343 203 436Q203 499 236 536Q268 573 325 573Q391 573 439 525L435 591Q432 628 483 636V692H442V716H483V753H517V716H558V692H517V636Q568 628 565 589L561 525Q608 573 675 573Q732 573 764 536Q797 499 797 436Q797 393 772 342Q748 292 687 227L701 24Q701 -4 647 -19Q592 -34 500 -34ZM500 422Q512 459 528 483V578Q528 