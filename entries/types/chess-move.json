Q473 727 458 716Q442 704 442 688Q442 655 485 637V606Q371 567 371 475Q371 412 450 376V338Q388 318 342 276Q296 233 271 176Q246 120 246 55Z\"};\nconst { view } = etude;\nconst S = 100, FILES = \"abcdefgh\";\nconst flip = view.side === \"b\";\nconst xy = (sq) => {\n  const f = FILES.indexOf(sq[0]), r = Number(sq[1]) - 1;\n  return flip ? [(7 - f) * S, r * S] : [f * S, (7 - r) * S];\n};\nconst sqAt = (x, y) => {\n  let f = Math.floor(x / S), r = 7 - Math.floor(y / S);\n  if (flip) { f = 7 - f; r = 7 - r; }\n  return f >= 0 && f < 8 && r >= 0 && r < 8 ? FILES[f] + (r + 1) : null;\n};\nconst mine = (p) => p && (view.side === \"w\" ? p === p.toUpperCase() : p === p.toLowerCase());\nconst board = { ...view.board };\n\netude.$(\".ch-turn\").innerHTML = `<span class=\"dot ${view.side}\"></span>${view.side === \"w\" ? \"White\" : \"Black\"} to move`;\nconst host = etude.$(\".ch-board\");\nlet squares = \"\", coords = \"\";\nfor (let f = 0; f < 8; f++) for (let r = 0; r < 8; r++) {\n  const sq = FILES[f] + (r + 1), [x, y] = xy(sq);\n  squares += `<rect class=\"sq ${(f + r) % 2 ? \"lt\" : \"dk\"}\" data-sq=\"${sq}\" role=\"button\" aria-label=\"${sq}\" x=\"${x}\" y=\"${y}\" width=\"${S}\" height=\"${S}\"/>`;\n}\nfor (let i = 0; i < 8; i++) {\n  const file = flip ? FILES[7 - i] : FILES[i], rank = flip ? i + 1 : 8 - i;\n  coords += `<text class=\"co ${(i % 2) ? \"on-lt\" : \"on-dk\"}\" x=\"${i * S + S - 6}\" y=\"${8 * S - 7}\" text-anchor=\"end\">${file}</text>`;\n  coords += `<text class=\"co ${(i % 2) ? \"on-dk\" : \"on-lt\"}\" x=\"6\" y=\"${i * S + 20}\">${rank}</text>`;\n}\nhost.innerHTML = `<svg viewBox=\"0 0 ${8 * S} ${8 * S}\" role=\"img\" aria-label=\"Chess board\"><g class=\"squares\">${squares}</g><g class=\"marks\"></g>${coords}<g class=\"pieces\"></g><g class=\"over\"></g></svg>`;\nconst svg = host.querySelector(\"svg\"), gp = svg.querySelector(\".pieces\"), gm = svg.querySelector(\".marks\"), go = svg.querySelector(\".over\");\n\nconst pieceSvg = (p, x, y, extra = \"\") => {\n  const t = p.toUpperCase(), white = p === t;\n  const tr = `translate(${x} ${y + 86.6}) scale(0.1 -0.1)`;\n  return `<g class=\"pc ${white ? \"w\" : \"b\"}\" ${extra}>${white\n    ? `<path transform=\"${tr}\" d=\"${PIECE[\"s\" + t]}\" class=\"fill\"/><path transform=\"${tr}\" d=\"${PIECE[\"o\" + t]}\" class=\"line\"/>`\n    : `<path transform=\"${tr}\" d=\"${PIECE[\"s\" + t]}\" class=\"fill\"/>`}</g>`;\n};\nconst draw = () => {\n  gp.innerHTML = Object.entries(board).map(([sq, p]) => { const [x, y] = xy(sq); return pieceSvg(p, x, y, `data-sq=\"${sq}\"`); }).join(\"\");\n};\ndraw();\n\nconst mark = (sq, cls) => { const [x, y] = xy(sq); return `<rect class=\"${cls}\" x=\"${x}\" y=\"${y}\" width=\"${S}\" height=\"${S}\"/>`; };\nlet from = null, move = typeof etude.answer === \"string\" ? etude.answer : null;\nconst showSel = () => {\n  let m = \"\";\n  if (move) m += mark(move.slice(0, 2), \"last\") + mark(move.slice(2, 4), \"last\");\n  if (from) m += mark(from, \"sel\");\n  gm.innerHTML = m;\n};\nconst commit = (a, b) => {\n  // Show the move on the board; it can be changed until Submit.\n  Object.assign(board, view.board);\n  for (const k of Object.keys(board)) if (!(k in view.board)) delete board[k];\n  move = a + b;\n  board[b] = board[a];\n  delete board[a];\n  // Promotion is always to a queen.\n  if (/[Pp]/.test(board[b]) && /[18]/.test(b[1])) { board[b] = view.side === \"w\" ? \"Q\" : \"q\"; move += \"q\"; }\n  from = null;\n  draw(); showSel();\n  etude.setReady(true);\n};\nconst local = (e) => {\n  const pt = svg.createSVGPoint(); pt.x = e.clientX; pt.y = e.clientY;\n  const p = pt.matrixTransform(svg.getScreenCTM().inverse());\n  return [p.x, p.y];\n};\nlet drag = null;\nsvg.addEventListener(\"pointerdown\", (e) => {\n  if (etude.mode !== \"answer\" || e.button > 0) return;\n  const [x, y] = local(e), sq = sqAt(x, y);\n  if (!sq) return;\n  e.preventDefault();\n  if (mine(view.board[sq])) {\n    from = sq; showSel();\n    drag = { sq, x0: e.clientX, y0: e.clientY, moved: false };\n    svg.setPointerCapture(e.pointerId);\n  } else if (from) commit(from, sq);\n});\nsvg.addEventListener(\"pointermove\", (e) => {\n  if (!drag) return;\n  if (!drag.moved && Math.hypot(e.clientX - drag.x0, e.clientY - drag.y0) < 6) return;\n  drag.moved = true;\n  const [x, y] = local(e);\n  go.innerHTML = pieceSvg(view.board[drag.sq], x - S / 2, y - S / 2);\n  gp.querySelector(`[data-sq=\"${drag.sq}\"]`)?.classList.add(\"lifted\");\n});\nconst endDrag = (e) => {\n  if (!drag) return;\n  go.innerHTML = \"\";\n  const moved = drag.moved, a = drag.sq;\n  drag = null;\n  if (!moved) return; // a tap: the piece stays selected\n  const [x, y] = local(e), b = sqAt(x, y);\n  if (b && b !== a) commit(a, b);\n  else { draw(); showSel(); }\n};\nsvg.addEventListener(\"pointerup\", endDrag);\nsvg.addEventListener(\"pointercancel\", () => { drag = null; go.innerHTML = \"\"; draw(); showSel(); });\netude.setReady(false);\nif (move) commit(move.slice(0, 2), move.slice(2, 4));\netude.getAnswer(() => move);\n\netude.onResult(({ key, answer, grade }) => {\n  const ok = grade?.score >= 1;\n  const tried = typeof answer === \"string\" && answer.length >= 4;\n  const best = key.answers[0];\n  // Reset to the start position, then animate the real mate.\n  for (const k of Object.keys(board)) delete board[k];\n  Object.assign(board, view.board);\n  draw();\n  const a = best.slice(0, 2), b = best.slice(2, 4);\n  let m = \"\";\n  if (tried && !ok) {\n    const [x1, y1] = xy(answer.slice(0, 2)), [x2, y2] = xy(answer.slice(2, 4));\n    m += `<line class=\"arrow bad\" x1=\"${x1 + S / 2}\" y1=\"${y1 + S / 2}\" x2=\"${x2 + S / 2}\" y2=\"${y2 + S / 2}\" marker-end=\"url(#ah-bad)\"/>`;\n  }\n  gm.innerHTML = mark(a, \"last ok\") + mark(b, \"last ok\");\n  go.innerHTML = `<defs><marker id=\"ah-bad\" viewBox=\"0 0 10 10\" refX=\"5\" refY=\"5\" markerWidth=\"3.2\" markerHeight=\"3.2\" orient=\"auto-start-reverse\"><path d=\"M0 0L10 5L0 10z\" class=\"ahb\"/></marker></defs>${m}`;\n  const el = gp.querySelector(`[data-sq=\"${a}\"]`);\n  const [xa, ya] = xy(a), [xb, yb] = xy(b);\n  const captured = gp.querySelector(`[data-sq=\"${b}\"]`);\n  setTimeout(() => {\n    if (el) { el.style.transition = \"transform 0.45s cubic-bezier(.3,.7,.2,1)\"; el.style.transform = `translate(${xb - xa}px, ${yb - ya}px)`; }\n    setTimeout(() => {\n      captured?.remove();\n      const [kx, ky] = xy(key.king);\n      gm.insertAdjacentHTML(\"beforeend\", `<circle class=\"mated\" cx=\"${kx + S / 2}\" cy=\"${ky + S / 2}\" r=\"${S * 0.46}\"/>`);\n    }, 420);\n  }, 350);\n  const san = key.san ? etude.mdInline(`**${key.san}**`) : `${a}–${b}`;\n  etude.$(\".ch-answer\").innerHTML = tried && !ok\n    ? `<p>The mate is ${san}. Your move, ${answer.slice(0, 2)}–${answer.slice(2, 4)}, is shown with the red arrow.</p>`\n    : `<p>${ok ? \"Checkmate: \" : \"The mate is \"}${san}.</p>`;\n});\n"
        },
