{
  "etudeMarket": 1,
  "kind": "deck",
  "id": "morse-code-letters",
  "name": "Morse code",
  "description": "Every character with a Morse code: A to Z, 0 to 9, punctuation, prosigns like SOS and SK, and accented letters, 94 cards with a memory hook each. Uses the Morse code card type, which comes along.",
  "author": "Joao Henrique Costa Araujo",
  "tags": [
    "morse",
    "radio",
    "ham radio"
  ],
  "version": "2",
  "updated": "2026-10-25",
  "content": {
    "etude": "pack/1",
    "name": "Morse code",
    "presets": [],
    "decks": [
      {
        "name": "Morse code",
        "description": "International Morse code, from Wikipedia's table of ITU-R M.1677-1 and the common extensions.",
        "instructions": ""
      },
      {
        "name": "Morse code::Letters",
        "description": "A to Z.",
        "instructions": ""
      },
      {
        "name": "Morse code::Numbers",
        "description": "0 to 9.",
        "instructions": ""
      },
      {
        "name": "Morse code::Punctuation",
        "description": "The ITU signs, plus ! & ; _ and the dollar sign, which aren't in the standard.",
        "instructions": ""
      },
      {
        "name": "Morse code::Prosigns",
        "description": "Procedure signals: letters run together with no gap, drawn with a bar on top.",
        "instructions": ""
      },
      {
        "name": "Morse code::Accented letters",
        "description": "Letters with diacritics. Several share one code.",
        "instructions": ""
      }
    ],
    "tags": [],
    "types": [
      {
        "id": "morse",
        "name": "Morse code",
        "description": "See a character, tap it out in dots and dashes; checked by script, then the right code blinks back. Handles prosigns and codes up to nine elements.",
        "fields": [
          {
            "name": "letter",
            "kind": "text",
            "required": true,
            "description": "The letter, digit, sign or prosign to send."
          },
          {
            "name": "name",
            "kind": "text",
            "description": "What it's called, shown under it (Full stop, End of contact). Optional."
          },
          {
            "name": "prosign",
            "kind": "boolean",
            "description": "Draw it with a bar on top: a prosign is sent as one run, with no gap between its letters."
          },
          {
            "name": "code",
            "kind": "text",
            "required": true,
            "private": true,
            "description": "Its Morse code, as . and -"
          },
          {
            "name": "mnemonic",
            "kind": "markdown",
            "private": true,
            "description": "A memory hook, shown after answering."
          }
        ],
        "prepare": "// The card only sees the character; the code and mnemonic stay in the key until grading.\nreturn {\n  view: { letter: fields.letter, name: fields.name ?? \"\", prosign: !!fields.prosign },\n  key: { code: fields.code, mnemonic: fields.mnemonic ?? \"\" },\n};\n",
        "template": {
          "html": "<div class=\"mo-eyebrow\">Tap it out in Morse</div>\n<div class=\"mo-letter\">{{letter}}</div>\n{{#name}}<div class=\"mo-name\">{{name}}</div>{{/name}}\n<div class=\"mo-tape mo-mine\" aria-live=\"polite\"></div>\n<div class=\"mo-pad only-answer\">\n  <button type=\"button\" class=\"mo-key\" data-s=\".\"><span class=\"mo-sym dot\"></span><small>dot <kbd>.</kbd></small></button>\n  <button type=\"button\" class=\"mo-key\" data-s=\"-\"><span class=\"mo-sym dash\"></span><small>dash <kbd>-</kbd></small></button>\n  <button type=\"button\" class=\"mo-key mo-del\" data-s=\"del\" aria-label=\"Delete\">⌫</button>\n</div>\n<template data-on=\"result\">\n  <div class=\"e-reveal mo-result\">\n    <div class=\"mo-lamp\"></div>\n    <div class=\"e-section-title\">{{letter}} in Morse</div>\n    <div class=\"mo-tape mo-correct\"></div>\n    {{#mnemonic}}<div class=\"prose e-muted\">{{md:mnemonic}}</div>{{/mnemonic}}\n  </div>\n</template>\n",
          "css": ".mo-eyebrow { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--highlight); margin-bottom: -0.75rem; }\n.mo-letter { font: 600 5.5rem/1 var(--font-mono); text-align: center; margin: 0.5rem 0 0; }\n.mo-letter.is-prosign { width: fit-content; margin: 0.9rem auto 0; line-height: 0.8; border-top: 0.06em solid currentColor; padding-top: 0.02em; }\n.mo-name { text-align: center; color: var(--muted-foreground); font-size: 0.9rem; margin-top: -0.6rem; }\n.mo-tape { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.7rem; min-height: 2.6rem; }\n.mo-tape.long { gap: 0.5rem; }\n.mo-tape.long .mo-sym.dot { width: 0.95rem; height: 0.95rem; }\n.mo-tape.long .mo-sym.dash { width: 2.5rem; height: 0.95rem; }\n.mo-empty { color: var(--muted-foreground); font-size: 0.9rem; }\n.mo-sym { --c: var(--highlight); display: inline-block; height: 1.1rem; border-radius: 999px; background: var(--c);\n  box-shadow: 0 0 6px color-mix(in oklab, var(--c) 80%, transparent), 0 0 18px color-mix(in oklab, var(--c) 45%, transparent); transition: transform 0.12s, filter 0.12s; }\n.mo-sym.dot { width: 1.1rem; }\n.mo-sym.dash { width: 3.3rem; }\n.mo-sym.new { animation: mo-pop 0.28s cubic-bezier(.2, 1.6, .4, 1); }\n.mo-sym.is-ok { --c: var(--success); }\n.mo-sym.is-bad { --c: var(--danger); }\n.mo-sym.is-missed { --c: var(--muted-foreground); opacity: 0.5; box-shadow: none; }\n.mo-sym.lit { filter: brightness(1.6); transform: scale(1.18); }\n@keyframes mo-pop { from { transform: scale(0.2); filter: brightness(2.2); } }\n.mo-pad { display: grid; grid-template-columns: 1fr 1fr auto; gap: 0.6rem; max-width: 26rem; width: 100%; margin: 0 auto; }\n.mo-key { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.55rem; height: 5.5rem; border-radius: var(--radius);\n  border: 1px solid var(--border); background: color-mix(in oklab, var(--foreground) 4%, transparent); color: var(--muted-foreground); cursor: pointer; transition: background 0.1s, transform 0.08s; }\n.mo-key:hover { background: color-mix(in oklab, var(--foreground) 9%, transparent); }\n.mo-key:active, .mo-key.down { transform: scale(0.96); background: color-mix(in oklab, var(--highlight) 18%, transparent); }\n.mo-key small { font-size: 0.75rem; }\n.mo-del { width: 4rem; font-size: 1.3rem; }\n.mo-result { display: flex; flex-direction: column; align-items: center; gap: 0.7rem; text-align: center; }\n.mo-result .e-section-title { margin: 0.3rem 0 -0.2rem; }\n.mo-lamp { flex: none; width: 3rem; height: 3rem; border-radius: 50%; background: color-mix(in oklab, var(--foreground) 10%, transparent); transition: background 0.05s, box-shadow 0.05s; }\n.mo-lamp.on { background: #ffe9a8; box-shadow: 0 0 14px #ffd36a, 0 0 42px color-mix(in oklab, #ffb02e 70%, transparent); }\n",
          "js": "const mine = etude.$(\".mo-mine\");\nif (etude.view.prosign) etude.$(\".mo-letter\").classList.add(\"is-prosign\");\nconst MAX = 9; // the longest code here is SOS, ...---...\nlet seq = typeof etude.answer === \"string\" ? etude.answer : \"\";\nconst sym = (s, cls = \"\") => `<span class=\"mo-sym ${s === \".\" ? \"dot\" : \"dash\"} ${cls}\"></span>`;\n\nconst draw = (fresh) => {\n  mine.innerHTML = seq ? [...seq].map((s, i) => sym(s, fresh && i === seq.length - 1 ? \"new\" : \"\")).join(\"\") : `<span class=\"mo-empty\">Tap dot and dash</span>`;\n  mine.classList.toggle(\"long\", seq.length > 6);\n  etude.setReady(seq.length > 0);\n};\nconst press = (s) => {\n  if (etude.mode !== \"answer\") return;\n  seq = s === \"del\" ? seq.slice(0, -1) : (seq + s).slice(0, MAX);\n  draw(s !== \"del\");\n};\netude.$$(\".mo-key\").forEach((b) => b.addEventListener(\"click\", () => press(b.dataset.s)));\nwindow.addEventListener(\"keydown\", (e) => {\n  const s = { \".\": \".\", \"-\": \"-\", j: \".\", k: \"-\", Backspace: \"del\" }[e.key];\n  if (!s || etude.mode !== \"answer\") return;\n  e.preventDefault();\n  press(s);\n  const b = etude.$(`.mo-key[data-s=\"${s}\"]`);\n  b?.classList.add(\"down\");\n  setTimeout(() => b?.classList.remove(\"down\"), 120);\n});\ndraw(false);\netude.getAnswer(() => seq);\n\netude.onResult(({ key, answer }) => {\n  const sent = String(answer ?? \"\");\n  const code = key.code;\n  // Your taps, marked symbol by symbol; anything you left out shows faded.\n  mine.innerHTML = [...sent].map((s, i) => sym(s, s === code[i] ? \"is-ok\" : \"is-bad\")).join(\"\") +\n    [...code.slice(sent.length)].map((s) => sym(s, \"is-missed\")).join(\"\");\n  mine.classList.toggle(\"long\", Math.max(sent.length, code.length) > 6);\n  const right = etude.$(\".mo-correct\");\n  right.classList.toggle(\"long\", code.length > 6);\n  right.innerHTML = [...code].map((s) => sym(s)).join(\"\");\n  // Blink the right code on the lamp at Morse timing: dot 1 unit, dash 3, gaps 1, then a pause.\n  const lamp = etude.$(\".mo-lamp\");\n  const parts = etude.$$(\".mo-correct .mo-sym\");\n  const U = 170;\n  const loop = (i) => {\n    if (!lamp.isConnected) return;\n    if (i === code.length) return setTimeout(() => loop(0), 6 * U);\n    lamp.classList.add(\"on\"); parts[i].classList.add(\"lit\");\n    setTimeout(() => {\n      lamp.classList.remove(\"on\"); parts[i].classList.remove(\"lit\");\n      setTimeout(() => loop(i + 1), U);\n    }, code[i] === \".\" ? U : 3 * U);\n  };\n  setTimeout(() => loop(0), 400);\n});\n"
        },
        "grader": {
          "kind": "script",
          "code": "// answer is the tapped sequence, e.g. \"-.-.\"\nconst sent = String(answer ?? \"\").replace(/[^.-]/g, \"\");\nconst ok = sent === key.code;\nreturn {\n  score: ok ? 1 : 0,\n  details: { sent },\n  feedback: ok ? undefined : `You sent ${sent || \"nothing\"}, but ${view.letter} is ${key.code}`,\n};\n"
        },
        "demo": "// An example answer for watch mode: the right code.\nreturn String(key.code ?? \"\");\n"
      }
    ],
